# Copy this file to .env and fill in the test patient credentials.
# .env is git-ignored: never commit real credentials.

# Required. Wrap a value in double quotes if it contains # (otherwise the rest
# of the line is read as a comment), e.g. E2E_PASSWORD="abc#123".
E2E_EMAIL=
E2E_PASSWORD=

# Optional: defaults point to the challenge environment
BASE_URL=https://light-it-qa-challenge.vercel.app
API_URL=https://qa-challenge-backend.vercel.app
